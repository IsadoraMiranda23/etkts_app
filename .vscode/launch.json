    "version": "0.2.0",
    "configurations": [
        {
            "name": "run debug local",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": ["--dart-define-from-file=envs/local.json"],
        },
        {
            "name": "run debug dev",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": ["--dart-define-from-file=envs/developer.json"]
        },
        {
            "name": "run release local",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": ["--release --dart-define-from-file=envs/local.json"]
        },
        {
            "name": "run release dev",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "args": ["--release --dart-define-from-file=envs/developer.json"]
        },
    ]
}